# --- Shopify ---
SHOPIFY_STORE_DOMAIN=zft1kp-2r.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Date filter — only orders on/after this date are ever pulled from
# Shopify. This is the "don't fetch old orders" control. Leave blank to
# fall back to a rolling window (ORDER_LOOKBACK_DAYS) instead.
SHOPIFY_SYNC_START_DATE=2026-08-01
# Only used if SHOPIFY_SYNC_START_DATE is blank.
ORDER_LOOKBACK_DAYS=30

# --- Delhivery ---
# Same token your Apps Script uses.
DELHIVERY_API_TOKEN=your_delhivery_token_here
DELHIVERY_BASE_URL=https://track.delhivery.com
# Prefix used to build ref_ids, e.g. NEAT-16768 — matches your sheet setup.
DELHIVERY_ORDER_ID_PREFIX=NEAT-

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/neat_delhivery_dashboard

# --- App ---
PORT=3000
# How often to auto-run the full sync (Shopify pull + Delhivery pass), in minutes.
SYNC_INTERVAL_MINUTES=30
